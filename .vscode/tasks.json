{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "${workspaceFolder}/src/*.cpp",
                "-I${workspaceFolder}/src",
                "-o",
                "${workspaceFolder}/build/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Сборка всех .cpp файлов из папки src"
        },
        {
            "label": "build-cmake",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build",
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}